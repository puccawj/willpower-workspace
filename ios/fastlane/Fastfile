default_platform(:ios)

platform :ios do
  desc "Build the app and upload it to TestFlight"
  lane :beta do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
    )

    match(type: "appstore", api_key: api_key, git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"])

    # The Xcode project has never been opened in Xcode itself (built entirely via CI), so
    # it still has CODE_SIGN_STYLE = Automatic with no DEVELOPMENT_TEAM set, which fails
    # archiving. Point it at the certificate/profile match just installed instead.
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "App/App.xcodeproj",
      team_id: ENV["APPLE_DEVELOPER_TEAM_ID"],
      code_sign_identity: "Apple Distribution",
      bundle_identifier: "org.willpowerinstitute.app",
      profile_name: "match AppStore org.willpowerinstitute.app",
    )

    increment_build_number(
      xcodeproj: "App/App.xcodeproj",
      build_number: ENV["GITHUB_RUN_NUMBER"] || Time.now.strftime("%Y%m%d%H%M"),
    )

    build_app(
      project: "App/App.xcodeproj",
      scheme: "App",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "org.willpowerinstitute.app" => "match AppStore org.willpowerinstitute.app",
        },
      },
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "One-time bootstrap: generate and push the initial signing certificate to the match repo (run with MATCH_READONLY=false)"
  lane :bootstrap_certs do
    api_key = app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: true,
    )
    match(type: "appstore", api_key: api_key, readonly: false, git_basic_authorization: ENV["MATCH_GIT_BASIC_AUTHORIZATION"])
  end
end
